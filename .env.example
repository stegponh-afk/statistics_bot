# ===== TELEGRAM =====
BOT_TOKEN=
# Владельцы бота (через запятую) — видят /admin с общей сводкой по всем чатам.
OWNER_IDS=123456789

# ===== DATABASE =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=statistics_bot
POSTGRES_USER=statistics_bot
POSTGRES_PASSWORD=change_me

# ===== REDIS =====
REDIS_URL=redis://redis:6379/0

# ===== HTTP API (мост «обязательная подписка» для чужих ботов) =====
# Порт слушает бот внутри контейнера, он же пробрасывается наружу в docker-compose.yml.
# Перед ним должен стоять реверс-прокси (Nginx/Caddy) с HTTPS на твоём домене.
API_HOST=0.0.0.0
API_PORT=8080
# Публичный адрес API — показывается админам на экране «Как подключить».
API_PUBLIC_URL=https://api.example.com
# Лимиты запросов: на один API-ключ и на IP для неавторизованных запросов.
API_RATE_LIMIT_PER_MINUTE=600
API_UNAUTH_RATE_LIMIT_PER_MINUTE=60

# ===== ОБЯЗАТЕЛЬНАЯ ПОДПИСКА =====
# Сколько секунд кэшировать результат getChatMember (подписан / не подписан).
FORCESUB_CACHE_TTL_SECONDS=60
# Не чаще чем раз в столько секунд показывать неподписанному пользователю подсказку.
FORCESUB_PROMPT_COOLDOWN_SECONDS=30

# ===== ЧАТЫ =====
# Как часто перечитывать список администраторов чата (getChatAdministrators).
ADMIN_SYNC_TTL_SECONDS=600
# Часовой пояс для статистики по умолчанию (границы «сегодня», активность по часам).
DEFAULT_TIMEZONE=Europe/Moscow

# ===== СТАТИСТИКА =====
# Сколько дней хранить события сообщений и частоты слов.
STATS_RETENTION_DAYS=90

LOG_LEVEL=INFO
